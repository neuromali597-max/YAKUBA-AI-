# --- AUTHENTIFICATION GOOGLE (obligatoire pour « Continuer avec Google ») ---
# 1. https://console.cloud.google.com/apis/credentials → « Créer des identifiants »
#    → « ID client OAuth » → type « Application Web »
# 2. Origines JavaScript autorisées :  http://localhost:3000
# 3. URI de redirection autorisés :    http://localhost:3000/api/auth/callback/google
#    (en production, remplacez par votre domaine : https://votre-domaine/api/auth/callback/google)
# 4. Écran de consentement OAuth : renseignez le nom « Yakuba AI » et l'email de support
AUTH_GOOGLE_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxxxxxxx
# Généré avec : npx auth secret
AUTH_SECRET=xxxxxxxx
# En production uniquement :
# AUTH_URL=https://votre-domaine

# Envoi réel des formulaires (contact, aide, contributions) vers Yakuba.contact@gmail.com.
# Sans ces variables, le site bascule automatiquement sur la messagerie du visiteur (mailto).
#
# Gmail : créer un « mot de passe d'application » (compte Google → Sécurité → Validation en 2 étapes
# → Mots de passe des applications), puis :
SMTP_USER=Yakuba.contact@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optionnel (valeurs par défaut Gmail) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- OCR (lecture de texte sur photo) ---
# Par défaut, Yakuba utilise Tesseract sur le serveur : aucune clé nécessaire,
# gratuit, et l'image ne quitte pas votre infrastructure.
# Pour passer à un service de vision externe (qualité supérieure sur les
# écritures manuscrites), renseignez ces deux variables :
# OCR_API_URL=https://votre-service-de-vision/endpoint
# OCR_API_KEY=xxxxxxxx
